# Server-side LLM settings. In the Streamlit UI users may supply their own key instead;
# the server key is only ever sent to LLM_BASE_URL only.
LLM_API_KEY=your-openrouter-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=upstage/solar-mini4
#LLM_MODEL=xiaomi/mimo-v2.5
# Comma-separated models tried in order after LLM_MODEL on 429/timeout/5xx/empty output.
FALLBACK_MODELS=inclusionai/ling-3.1-flash,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,cohere/north-mini-code:free,liquid/lfm-2.5-2.6b:free,inclusionai/ling-3.1-flash,inclusionai/ling-3.0-flash-vl,xiaomi/mimo-v2.6-flash,meta-llama/llama-4-scout,upstage/solar-pro4
# Max models tried per request (caps cost when providers are rate-limiting).
LLM_MAX_ATTEMPTS=4
# Per-attempt timeout in seconds.
LLM_TIMEOUT_S=30
# Optional annual risk-free rate overrides used for Sharpe ratios (defaults are assumptions).
# RISK_FREE_RATE_US=0.04
# RISK_FREE_RATE_IN=0.065
